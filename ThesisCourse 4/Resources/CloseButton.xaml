<UserControl x:Class="ThesisCourse_4.Resources.CloseButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="25" Width="25" Background="Transparent">

    <Button Width="25" Height="25" Background="Transparent" BorderThickness="0" 
            ToolTip="Закрыть"
            Click="CloseClick">
        <Button.Style>
            <Style TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 5,5 L 20,20 M 20,5 L 5,20" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Height="25" Stretch="Fill" Width="25"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#EF4444"/>
                        <Setter Property="Background" Value="#FFECEC"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Foreground" Value="#B42B3B"/>
                        <Setter Property="Background" Value="#FFD6D6"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Button.Style>
    </Button>
</UserControl>
