<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Иконка "Добавить граф" (плюс в круге) -->
    <DrawingImage x:Key="Icon_AddGraph">
        
        <DrawingImage.Drawing>
            
            <DrawingGroup>
                
                <!-- Круг -->
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,12" RadiusX="11" RadiusY="11"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#32CD32" Thickness="2"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Плюс -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="12,6" EndPoint="12,18"/>
                            <LineGeometry StartPoint="6,12" EndPoint="18,12"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#32CD32" Thickness="2"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Иконка шестерёнки (настройки) -->
    <DrawingImage x:Key="Icon_Settings">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#32CD32">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M12,0 L14,0 L15,3 L18,4 L20,2 L22,4 L21,7 L24,9 L24,11 L21,13 L22,16 L20,18 L18,16 L15,17 L14,20 L12,20 L11,17 L8,16 L6,18 L4,16 L5,13 L2,11 L2,9 L5,7 L4,4 L6,2 L8,4 L11,3 Z"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
