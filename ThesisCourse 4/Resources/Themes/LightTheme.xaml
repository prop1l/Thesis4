<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Фоновые цвета -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="SecondBackgroundBrush" Color="#E5E7EB"/>

    <!-- Цвета текста -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="ForegroundBrushToTextBox" Color="#151515"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#374151"/>
    <SolidColorBrush x:Key="TitleBarCloseForegroundBrush" Color="#6B7280"/>

    <!-- Цвета панели заголовка -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F3F4F6"/>

    <!-- Кнопки -->
    <SolidColorBrush x:Key="ButtonNormalBackground" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#2563EB"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="White"/>

    <!-- Кнопка закрытия при наведении -->
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#EF4444"/>
</ResourceDictionary>

