<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundBrush" Color="Aqua"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="White"/>

    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="AliceBlue"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="TitleBarCloseForegroundBrush" Color="Bisque"/>

    <SolidColorBrush x:Key="ButtonNormalBackground" Color="AliceBlue"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#357ABD"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#2A6399"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="White"/>


    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#E53E3E"/>

</ResourceDictionary>