<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Фоновые цвета -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#151515"/>
    <SolidColorBrush x:Key="SecondBackgroundBrush" Color="#1A1A1A"/>

    <!-- Цвета текста -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ForegroundBrushToTextBox" Color="#151515"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarCloseForegroundBrush" Color="#FFFFFF"/>

    <!-- Цвета панели заголовка -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#3A3A3A"/>

    <!-- Кнопки -->
    <SolidColorBrush x:Key="ButtonNormalBackground" Color="#4A90E2"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#357ABD"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#2A6399"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="White"/>

    <!-- Узлы -->
    <SolidColorBrush x:Key="EdgeBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#E53E3E"/>

</ResourceDictionary>
