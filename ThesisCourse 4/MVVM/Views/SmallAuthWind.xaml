<Window x:Class="ThesisCourse_4.MVVM.Views.SmallAuthWind"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThesisCourse_4.MVVM.Views"
        
        xmlns:ctrl="clr-namespace:ThesisCourse_4.Resources"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:ThesisCourse_4.Behaviors"
        
        mc:Ignorable="d"
        Title="SmallAuthWind"
        Height="500" Width="400"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">


    <Border Background="{DynamicResource BackgroundBrush}"
            CornerRadius="15"
            Margin="20"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

        <StackPanel Margin="20">

            <ctrl:CloseButton Height="26"/>

            <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}"
                          Width="60" Height="30"
                          IsChecked="{Binding IsLight, Mode=TwoWay}"
                          Content="{Binding IsLight}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="10"/>

            <TextBlock Text="Авторизация"
                       Foreground="{DynamicResource ForegroundBrush}"
                       HorizontalAlignment="Center"
                       FontSize="40"
                       Margin="0,50,0,30"
                       FontFamily="Fonts/Montserrat-Regular.ttf"/>

            <TextBox x:Name="Login"
                     Style="{StaticResource RoundedPlaceholderTextBox}"
                     Foreground="Gray"
                     Height="35"
                     FontSize="15"
                     Tag="Логин"
                     GotFocus="LoginFocus"
                     VerticalAlignment="Center"/>

            <PasswordBox x:Name="Password"
                         Style="{StaticResource RoundedPlaceholderPasswordBox}"
                         Foreground="Black"
                         Height="35"
                         FontSize="15"
                         Tag="Пароль"
                         Margin="0,20,0,20">

                <i:Interaction.Behaviors>
                    <behaviors:PasswordBoxPlaceholderBehavior/>
                </i:Interaction.Behaviors>

            </PasswordBox>
            
            
            <Button Content="Войти"
                    Style="{StaticResource RoundedButton}"
                    Width="180"
                    Height="40"
                    FontFamily="Fonts/Montserrat-Regular.ttf"
                    VerticalAlignment="Center"
                    Click="OnLoginButtonClick"/>

            <Label Content="Ещё нет аккаунта?"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource ForegroundBrush}"
                   FontSize="14"
                   FontFamily="Fonts/Montserrat-Regular.ttf"/>

        </StackPanel>

        <Border.Effect>
            <DropShadowEffect Opacity=".223"/>
        </Border.Effect>

    </Border>
</Window>