<Window x:Class="ThesisCourse_4.MVVM.Views.GraphEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:ThesisCourse_4.Resources"
        xmlns:local="clr-namespace:ThesisCourse_4.Services"
        Title="Graph Editor"
        
        Width="1347" Height="800"
        MinHeight="500" MinWidth="700" 
        
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <local:ReferenceEqualsConverter x:Key="ReferenceEqualsConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <ctrl:Header x:Name="Header"/>

        <Border Background="{DynamicResource SecondBackgroundBrush}"
                Padding="10"
                Grid.Row="1">

            <DockPanel>
                <Grid>
                    <Canvas x:Name="PreviewCanvas" IsHitTestVisible="False"/>

                    
                    
                    <!-- Узлы -->
                    <ItemsControl ItemsSource="{Binding Edges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="Transparent"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line Stroke="{DynamicResource EdgeBrush}" 
                                      StrokeThickness="2"
                                      X1="{Binding FromNode.CenterX}"
                                      Y1="{Binding FromNode.CenterY}"
                                      X2="{Binding ToNode.CenterX}"
                                      Y2="{Binding ToNode.CenterY}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Вершины -->
                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="Transparent"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Ellipse x:Name="NodeEllipse"
                                             Width="60" Height="60"
                                             Fill="LightSteelBlue"
                                             Stroke="SteelBlue"
                                             StrokeThickness="2"
                                             PreviewMouseLeftButtonDown="Ellipse_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="Ellipse_PreviewMouseMove"
                                             PreviewMouseLeftButtonUp="Ellipse_PreviewMouseLeftButtonUp"
                                             PreviewMouseRightButtonDown="Ellipse_PreviewMouseRightButtonDown"
                                             PreviewMouseRightButtonUp="Ellipse_PreviewMouseRightButtonUp"/>

                                    <TextBlock Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>

                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource ReferenceEqualsConverter}">
                                                <Binding />
                                                <!-- текущий Node -->
                                                <Binding Path="DataContext.SelectedNodeToRemove"
                                                         RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="NodeEllipse" Property="Stroke" Value="Red"/>
                                        <Setter TargetName="NodeEllipse" Property="StrokeThickness" Value="4"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Canvas x:Name="TrashCanvas"
                            Width="80" Height="80"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="20,0,0,20"
                            Panel.ZIndex="99">
                        <Image Source="/Resources/Icons/TrashIcon.png"
                               Width="80" Height="80"/>
                    </Canvas>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">

                <Button Content="{DynamicResource Editor_Add_Edges}"
                        Command="{Binding AddNodeCommand}" 
                        Style="{StaticResource RoundedButton}"
                        Margin="5"/>

                <ComboBox Margin="5" 
                          Style="{StaticResource CleanComboBox}"
                          ItemsSource="{Binding Nodes}"
                          SelectedItem="{Binding SelectedNodeToRemove}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>



                <Button Content="X"
                        Command="{Binding ClearSelectedNodeCommand}"
                        Style="{StaticResource RoundedButton}"
                        Margin="5"/>

                <Button Content="{DynamicResource Editor_Delete_Edges}"
                        Command="{Binding RemoveSelectedNodeCommand}"
                        Style="{StaticResource RoundedButton}"
                        Margin="5"/>

                <Button Content="{DynamicResource Editor_Delete_All}"
                        Command="{Binding RemoveAllCommand}"
                        Style="{StaticResource RoundedButton}"
                        Margin="5"/>

                <Button Content="{DynamicResource Editor_Random}"
                        Command="{Binding FullRandomizeLayoutCommand}"
                        Style="{StaticResource RoundedButton}"
                        Margin="5"/>

                <Button Content="{DynamicResource Editor_BFS}"
                        Command="{Binding RandomizeLayoutCommand}"
                        Style="{StaticResource RoundedButton}"
                        Margin="5"/>

                <Button Content="{DynamicResource Editor_Tree}"
                        Command="{Binding TreeLayoutCommand}"
                        Style="{StaticResource RoundedButton}"
                        Margin="5"/>

                <Button Content="{DynamicResource Editor_Matrixn}"
                        Command="{Binding OpenMatrixCommand}"
                        Style="{StaticResource RoundedButton}"
                        Margin="5"/>

            </StackPanel>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal">

                <Button Content="{DynamicResource Editor_Save}" Grid.Column="2"
                    Command="{Binding SaveCommand}" 
                    Style="{StaticResource RoundedButton}"
                    Margin="5"/>
                
            </StackPanel>
        </Grid>
    </Grid>
</Window>
