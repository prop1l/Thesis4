<Window x:Class="ThesisCourse_4.MVVM.Views.GraphEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:ThesisCourse_4.Resources"
        Title="Graph Editor"
        Width="1000" Height="800"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <ctrl:Header x:Name="Header"/>

        <Border Background="{DynamicResource SecondBackgroundBrush}"
                Padding="10"
                Grid.Row="1">

            <DockPanel>
                <Grid>
                    <Canvas x:Name="PreviewCanvas" IsHitTestVisible="False"/>
                    <!-- Edges -->
                    <ItemsControl ItemsSource="{Binding Edges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="Transparent"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line Stroke="Black" StrokeThickness="2"
                                      X1="{Binding FromNode.CenterX}"
                                      Y1="{Binding FromNode.CenterY}"
                                      X2="{Binding ToNode.CenterX}"
                                      Y2="{Binding ToNode.CenterY}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Nodes -->
                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="Transparent"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Ellipse Width="60" Height="60"
                                             Fill="LightSteelBlue"
                                             Stroke="SteelBlue"
                                             StrokeThickness="2"
                                             PreviewMouseLeftButtonDown="Ellipse_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="Ellipse_PreviewMouseMove"
                                             PreviewMouseLeftButtonUp="Ellipse_PreviewMouseLeftButtonUp"
                                             PreviewMouseRightButtonDown="Ellipse_PreviewMouseRightButtonDown"
                                             PreviewMouseRightButtonUp="Ellipse_PreviewMouseRightButtonUp" />
                                    <TextBlock Text="{Binding Label}"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </DataTemplate>

                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal">
            
            <Button Content="Добавить Узел"
                Command="{Binding AddNodeCommand}" 
                Style="{StaticResource RoundedButton}"
                Margin="5"/>
            
            <Button Content="Сохранить" Grid.Row="2"
                Command="{Binding SaveCommand}" 
                Style="{StaticResource RoundedButton}"
                Margin="5"/>
            
        </StackPanel>

    </Grid>
</Window>
