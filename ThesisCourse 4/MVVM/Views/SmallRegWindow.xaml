<Window x:Class="ThesisCourse_4.MVVM.Views.SmallRegWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThesisCourse_4.MVVM.Views"
        
        xmlns:ctrl="clr-namespace:ThesisCourse_4.Resources"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:ThesisCourse_4.Behaviors"
        
        mc:Ignorable="d"
        Title="SmallAuthWind"
        Height="500" Width="400"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">



    <Border Background="{DynamicResource BackgroundBrush}"
        CornerRadius="15"
        Margin="20"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

        <StackPanel Margin="20">

            <ctrl:CloseButton Height="26" HorizontalAlignment="Right" Width="60"/>

            <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}"
                      Width="60" Height="30"
                      IsChecked="{Binding IsLight, Mode=TwoWay}"
                      Content="{Binding IsLight}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="10"/>

            <TextBlock Text="{DynamicResource Reg_Title}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       HorizontalAlignment="Center"
                       FontSize="40"
                       Margin="0,10,0,30"
                       FontFamily="Fonts/Montserrat-Regular.ttf"/>

            <TextBox x:Name="Login"
                     Style="{StaticResource RoundedPlaceholderTextBox}"
                     Foreground="Gray"
                     Height="35"
                     FontSize="15"
                     Tag="{DynamicResource General_Login}"
                     GotFocus="LoginFocus"
                     VerticalAlignment="Center"/>

            <PasswordBox x:Name="Password"
                         Style="{StaticResource RoundedPlaceholderPasswordBox}"
                         Foreground="Black"
                         Height="35"
                         FontSize="15"
                         Tag="{DynamicResource General_Password}"
                         Margin="0,20,0,0">
    
                <i:Interaction.Behaviors>
                    <behaviors:PasswordBoxPlaceholderBehavior/>
                </i:Interaction.Behaviors>

            </PasswordBox>

            <PasswordBox x:Name="PasswordAgain"
                         Style="{StaticResource RoundedPlaceholderPasswordBox}"
                         Foreground="Black"
                         Height="35"
                         FontSize="15"
                         Tag="{DynamicResource General_PasswordAgain}"
                         Margin="0,20,0,20">
    
                <i:Interaction.Behaviors>
                    <behaviors:PasswordBoxPlaceholderBehavior/>
                </i:Interaction.Behaviors>

            </PasswordBox>


            <Button Content="{DynamicResource General_In}"
                    Style="{StaticResource RoundedButton}"
                    Width="180"
                    Height="40"
                    FontFamily="Fonts/Montserrat-Regular.ttf"
                    VerticalAlignment="Center"
                    Click="OnLoginButtonClickInRegistraton"/>

            <Button Content="{DynamicResource Reg_YesAccount}"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource ForegroundBrush}"
                    FontSize="14"
                    FontFamily="Fonts/Montserrat-Regular.ttf"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding OpenAuthWindowCommand}"/>

        </StackPanel>
        <Border.Effect>
            <DropShadowEffect Opacity=".223"/>
        </Border.Effect>
    </Border>


</Window>
