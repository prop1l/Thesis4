<Window x:Class="ThesisCourse_4.MVVM.Views.Welcome"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
            xmlns:local="clr-namespace:ThesisCourse_4.MVVM.Views"
            xmlns:ctrl="clr-namespace:ThesisCourse_4.Resources"
            xmlns:behaviors="clr-namespace:ThesisCourse_4.Behaviors"
            
            mc:Ignorable="d"
            Title="GraphIS"
            Height="800" Width="1150" 
            MinHeight="800" MinWidth="1150"
            Background="Transparent"
            AllowsTransparency="False"
            WindowStyle="None"
            ResizeMode="CanResize"
            WindowStartupLocation="CenterScreen">

    <Border Background="{DynamicResource BackgroundBrush}">
        <Grid x:Name="MainGrid">

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="98"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.36*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="6"
                    Grid.Column="1" Grid.ColumnSpan="5" Margin="-20,-20,-20,-20"
                    Background="{DynamicResource SecondBackgroundBrush}"
                    CornerRadius="20">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.36*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="1" Grid.Column="3"
                             Text="{Binding GraphName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource RoundedPlaceholderTextBox}"
                             Tag="{DynamicResource Welcome_Name_Card}"
                             FontSize="24" Height="55"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource ForegroundBrushToTextBox}"/>

                    <Button Grid.Row="1" Grid.Column="5"
                            Style="{StaticResource RoundedDashedBorderButton}"
                            FontSize="20"
                            Command="{Binding AddGraphCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Icon_AddGraph}" 
                                   Width="40" Height="40"
                                   Margin="0 0 5 0"/>
                            <TextBlock Text="{DynamicResource Welcome_Add_Card}"
                                       FontSize="29" Height="40"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>


                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.RowSpan="5"
                    Grid.Column="1" Grid.ColumnSpan="5" 
                    Margin="-4 -1 -40 0"
                    CornerRadius="20"
                    Background="{DynamicResource SecondBackgroundBrush}">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource ModernScrollViewer}"
                              Margin="40 80 40 75">

                    <ItemsControl ItemsSource="{Binding Buttons}" x:Name="ButtonsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid x:Name="ButtonsContainer"
                                      behaviors:DynamicGridBehavior.GridState="{Binding GridState}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="1.36*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Row" Value="{Binding Row}" />
                                <Setter Property="Grid.Column" Value="{Binding Column}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RoundedButton}"
                                        Command="{Binding DataContext.OpenGraphEditorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="5"
                                        FontSize="24"
                                        Foreground="{DynamicResource ForegroundBrush}">
                                    <TextBlock Text="{Binding Name}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontSize="24"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>



            <ctrl:Header Grid.ColumnSpan="7" x:Name="Header"/>

            <Button Content="{DynamicResource Welcome_Sign}"
                    Command="{Binding OpenAuthWindowCommand}"
                    Style="{StaticResource RoundedButton}"
                    Margin="5"
                    Padding="10,5"
                    Grid.Column="3"
                    Foreground="{DynamicResource ForegroundBrush}"/>


            <Button Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Width="50"
                    Height="50"
                    Margin="10 0 0 0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SettingsButton_OnClick"
                    Panel.ZIndex="99">



                <Button.Content>
                    <Image Source="E:\Repos\C#\ThesisCourse 4\ThesisCourse 4\Resources\Icons\SettingsIcon.png"/>
                </Button.Content>

                <Button.ContextMenu> 
                    <ContextMenu Placement="Bottom" 
                                 PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Button}}">
                        
                        <MenuItem Header="{DynamicResource Menu_ChangeLanguage}"
                                  Command="{Binding ChangeLanguageCommand}" />
                        
                        <MenuItem Header="{DynamicResource Menu_ChangeTheme}"
                                  Command="{Binding ToggleThemeCommand}" />
                        
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!--    <Button Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Width="32" Height="32"
                    Margin="0,0,10,0"
                    Background="Transparent"
                    BorderThickness="0"
                    behaviors:HoverContextMenuBehavior.IsHoverEnabled="True"
                    ToolTip="Настройки">

                <Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                        <MenuItem Header="{DynamicResource Menu_ChangeLanguage}"
                      Command="{Binding OpenLanguageDialogCommand}"/>
                        <MenuItem Header="{DynamicResource Menu_ChangeTheme}"
                      Command="{Binding ToggleThemeCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button> -->




            <!--            <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}"
                          Width="60" Height="30"
                          IsChecked="{Binding IsLight, Mode=TwoWay}"
                          Grid.Row="0"
                          Grid.Column="5"/> -->
        </Grid>
    </Border>
</Window>
