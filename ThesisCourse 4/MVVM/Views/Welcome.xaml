<Window x:Class="ThesisCourse_4.MVVM.Views.Welcome"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThesisCourse_4.MVVM.Views"
        
        xmlns:ctrl="clr-namespace:ThesisCourse_4.Resources"
        xmlns:behaviors="clr-namespace:ThesisCourse_4.Behaviors"
        
        mc:Ignorable="d"
        Title="GraphIS"
        Height="1024" MinHeight="1024"
        Width="1440" MinWidth="1440"
        Background="Transparent"
        AllowsTransparency="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Border Background="{DynamicResource BackgroundBrush}">
        <Grid x:Name="MainGrid">

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="98"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.36*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="6"
                    Grid.Column="1" Grid.ColumnSpan="5" Margin="-20,-20,-20,-20"
                    Background="{DynamicResource SecondBackgroundBrush}"
                    CornerRadius="20">

                <Grid >

                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="346"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding GraphName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource RoundedPlaceholderTextBox}"
                             Tag="Введите название для графа"
                             FontSize="24" Height="55"
                             VerticalAlignment="Center"/>

                    <Button Grid.Row="1" Grid.Column="3"
                            Style="{StaticResource RoundedDashedBorderButton}"
                            FontSize="20"
                            Command="{Binding AddGraphCommand}">
                        <StackPanel Orientation="Horizontal" >
                            <Image Source="{StaticResource Icon_AddGraph}" 
                                   Width="60" Height="40" 
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Добавить"
                                       FontSize="36" Height="57"/>
                        </StackPanel>
                    </Button>

                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.RowSpan="5"
                    Grid.Column="1" Grid.ColumnSpan="5" 
                    Margin="-40,-1,-40,0"
                    CornerRadius="20"
                    Background="{DynamicResource SecondBackgroundBrush}">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Style="{StaticResource ModernScrollViewer}"
                  Margin="40,80,40,75">

                    <ItemsControl ItemsSource="{Binding Buttons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid x:Name="ButtonsContainer"
                                      behaviors:DynamicGridBehavior.GridState="{Binding GridState}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="1.36*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Row" Value="{Binding Row}" />
                                <Setter Property="Grid.Column" Value="{Binding Column}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Style="{StaticResource RoundedButton}"
                                        Height="100"
                                        Margin="5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>
            </Border>

            <ctrl:Header Grid.ColumnSpan="7" x:Name="Header"/>

            <Button Content="🔐 Войти"
                    Command="{Binding OpenAuthWindowCommand}"
                    Style="{StaticResource RoundedButton}"
                    Margin="5"
                    Padding="10,5"
                    Grid.Column="3"/>

            <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}"
                          Width="60" Height="30"
                          IsChecked="{Binding IsLight, Mode=TwoWay}"
                          Grid.Row="0"
                          Grid.Column="5"/>

        </Grid>
    </Border>

</Window>


        